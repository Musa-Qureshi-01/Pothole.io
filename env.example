# Frontend Environment Variables
# Copy this file to frontend/.env.local and fill in your values

# Neon Auth
VITE_NEON_AUTH_URL=https://ep-ancient-pond-aoaofy0n.neonauth.c-2.ap-southeast-1.aws.neon.tech/neondb/auth

# Neon Data API
VITE_NEON_DATA_API_URL=https://ep-ancient-pond-aoaofy0n.apirest.c-2.ap-southeast-1.aws.neon.tech/neondb/rest/v1

# Google Gemini API
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Backend API
VITE_API_URL=http://127.0.0.1:8000

# Backend Environment Variables
# Copy this file to backend/.env and fill in your values

# Neon Database Connection
DATABASE_URL=postgresql://username:password@ep-ancient-pond-aoaofy0n.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# CORS Origins
CORS_ORIGINS=http://localhost:5174,http://localhost:3000
